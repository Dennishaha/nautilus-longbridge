LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_ACCOUNT_ID=
LONGBRIDGE_PAPERTRADING=true
LONGBRIDGE_DRY_RUN=true
LONGBRIDGE_REGION=hk
LONGBRIDGE_HTTP_URL=https://openapi.longbridge.com
LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridge.com/v2
LONGBRIDGE_TRADE_WS_URL=wss://openapi-trade.longbridge.com/v2
LONGBRIDGE_REQUEST_TIMEOUT_SECS=15
LONGBRIDGE_RECONNECT_INITIAL_SECS=1
LONGBRIDGE_RECONNECT_MAX_SECS=30
LONGBRIDGE_QUEUE_SIZE=10000

# Explicit opt-ins. Keep unset for normal development.
LONGBRIDGE_ENABLE_LIVE_SMOKE=0
LONGBRIDGE_ENABLE_ORDER_SMOKE=0
LONGBRIDGE_ENABLE_REAL_TRADING=0
